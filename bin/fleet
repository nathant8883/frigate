#!/usr/bin/env python3
"""frigate fleet board — in-flight work, with live crew status overlaid from herdr.

Usage:
  bin/fleet            render the board to stdout (joins live `herdr agent list`)
  bin/fleet --write    also snapshot the board to FLEET.md
Env:
  FLEET_NO_HERDR=1     skip the herdr query (static board from the ledger only)

fleet.json is the mate's source of truth. The Crew column is overlaid live from herdr at
render time, joined on worktree path (cwd) — durable across herdr restarts (pane ids are not).
Run it on a refresh loop for a live dashboard:  watch -n 5 /home/nturner/frigate/bin/fleet
"""
import json, os, re, shutil, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LEDGER = os.path.join(ROOT, "fleet.json")
SNAPSHOT = os.path.join(ROOT, "FLEET.md")

# Layout — the board flexes to fill the terminal width. Summary is the elastic column:
# it soaks up whatever horizontal room the pane gives (within these bounds), and the
# continuation-line Jira budget keys off it, so a wider pane means wider summaries and
# less Jira truncation. Widen the dashboard pane and the board widens with it. Override
# the auto-detected width with FLEET_WIDTH=<cols> (e.g. for FLEET.md snapshots).
SUMMARY_MIN, SUMMARY_MAX = 20, 120
SUBSTEP_MIN = 24     # phase substep (PR #, test target) floor on the stacked continuation line


def term_width():
    env = os.environ.get("FLEET_WIDTH")
    if env and env.isdigit():
        return int(env)
    # Under `watch` stdout is a pipe, so query the controlling tty directly first — that's
    # the real pane width — then fall back to stdout / a sane default.
    try:
        fd = os.open("/dev/tty", os.O_RDONLY)
        try:
            w = os.get_terminal_size(fd).columns
        finally:
            os.close(fd)
        if w and w > 0:
            return w
    except Exception:
        pass
    try:
        return shutil.get_terminal_size(fallback=(110, 40)).columns
    except Exception:
        return 110

CREW = {
    "working": "🔄 working",
    "blocked": "🔴 blocked",
    "idle":    "🟡 idle",
    # herdr "done" = agent finished its turn (unread) — NOT work done. Work isn't done
    # until it's merged through Jira + PR, so a finished crewmate reads as idle here.
    "done":    "🟡 idle",
    "unknown": "❔ unknown",
}
NO_AGENT = "—"
HERDR_DOWN = "✗ herdr"
FEEDBACK = "🔴 feedback"   # ledger `blocked` note set → crew is waiting on captain feedback


def trunc(s, n):
    s = str(s)
    return s if len(s) <= n else s[: n - 1] + "…"


# status circles render as two terminal cells but len() counts them as one;
# dwidth/pad keep columns aligned when a crew emoji is present.
WIDE = set("🔄🟢🔴🟡⚪❔")


def dwidth(s):
    return sum(2 if ch in WIDE else 1 for ch in str(s))


def pad(s, w):
    s = str(s)
    return s + " " * max(0, w - dwidth(s))


# --- SDLC phase track -------------------------------------------------------
# The canonical AIO pipeline. A task's granular ledger `stage` (Kickoff, Build,
# Squash, PR, Ready-for-Testing, …) rolls up to one of these phases so the board
# shows an at-a-glance progress track instead of a bare word. Order matters.
# Tail: Review (code review) → Validation (3rd-party QA) → Merge (green & mergeable:
# CI passing, no conflicts — the captain's merge gate) → Shipped (merged).
PHASES = ["Planning", "Building", "Housekeeping", "Testing",
          "Review", "Validation", "Merge", "Shipped"]
# short labels for the legend line only (cells still show the full PHASES names),
# so the 8-phase key fits on one line in a narrow pane.
_PHASE_ABBR = ["Plan", "Build", "House", "Test", "Review", "Valid", "Merge", "Ship"]

# tolerant map: compact (alphanumeric-only, lowercased) stage token -> phase index.
# Lets the mate keep noting fine-grained, skill-linked stages while the board renders
# the rollup. Multi-word Jira statuses match as a whole — "readyfortesting" is
# third-party QA → Validation, deliberately NOT the dev's own Testing phase.
_STAGE_TO_PHASE = {
    "kickoff": 0, "planning": 0, "plan": 0, "spec": 0, "intake": 0, "brainstorm": 0,
    "build": 1, "building": 1, "dev": 1, "implement": 1, "code": 1, "coding": 1,
    "housekeeping": 2, "cleanup": 2, "simplify": 2,
    "testing": 3, "test": 3, "e2e": 3, "unittest": 3,
    "squash": 3, "squashpush": 3, "push": 3, "ci": 3,
    "review": 4, "pr": 4, "codereview": 4, "readyforreview": 4, "inreview": 4,
    "validation": 5, "validate": 5, "qa": 5, "readyfortesting": 5, "manualqa": 5,
    "merge": 6, "readytomerge": 6, "mergeable": 6, "approved": 6,
    "shipped": 7, "merged": 7, "done": 7, "ship": 7, "complete": 7,
}
PH_DONE, PH_CUR, PH_TODO = "●", "◉", "○"   # done · current · todo — all single-width


def phase_of(stage):
    """(index, name) for a granular stage; (None, raw) if it maps to no known phase."""
    raw = str(stage).strip()
    compact = re.sub(r"[^a-z0-9]", "", raw.lower())   # "Ready for Testing" -> "readyfortesting"
    if compact in _STAGE_TO_PHASE:
        i = _STAGE_TO_PHASE[compact]
        return i, PHASES[i]
    for i, p in enumerate(PHASES):                    # already a canonical phase name?
        if compact == p.lower():
            return i, p
    m = re.match(r"[a-z0-9]+", raw.lower())            # first token, e.g. "squash + push" -> "squash"
    if m and m.group(0) in _STAGE_TO_PHASE:
        i = _STAGE_TO_PHASE[m.group(0)]
        return i, PHASES[i]
    return None, raw


def phase_cell(stage):
    """`●●◉○○ Housekeeping` — the progress track + phase name. Any substep (PR #,
    test target) is rendered separately on the stacked secondary line, not here."""
    i, name = phase_of(stage)
    if i is None:                           # non-AIO project / unknown stage → raw text
        return name or "—"
    track = "".join(PH_DONE if j < i else PH_CUR if j == i else PH_TODO
                    for j in range(len(PHASES)))
    return f"{track} {_PHASE_ABBR[i]}"        # short label keeps the board narrow


def phase_legend():
    steps = " ".join(_PHASE_ABBR)          # no numbers — the track glyphs show position
    return f"Phases: {steps}  ({PH_DONE}done {PH_CUR}now {PH_TODO}todo)"


def live_status_by_cwd():
    """worktree path -> (crew label, pane_id). None if herdr is unavailable/skipped."""
    if os.environ.get("FLEET_NO_HERDR"):
        return None
    try:
        out = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, timeout=8)
        agents = json.loads(out.stdout).get("result", {}).get("agents", [])
    except Exception:
        return None
    m = {}
    for a in agents:
        cwd = (a.get("foreground_cwd") or a.get("cwd") or "").rstrip("/")
        if cwd:
            m[cwd] = (CREW.get(a.get("agent_status", "unknown"), CREW["unknown"]), a.get("pane_id", ""))
    return m


def load_ledger():
    try:
        with open(LEDGER) as f:
            return json.load(f)
    except Exception:
        return {"in_flight": [], "done": []}


def render():
    led = load_ledger()
    live = live_status_by_cwd()
    # Borderless columns with a light rule between tickets. Each ticket is a primary
    # line (ticket / summary / project / phase-track / crew) plus an optional
    # continuation line that tucks the Jira status under the ticket and any phase
    # substep (PR #, test target) under the phase — each marked with a ↳ so it clearly
    # hangs off the row above. No vertical borders: a glyph-width miscount then just
    # nudges a column instead of cracking a border. Branch dropped from the grid (it
    # mostly duplicates the ticket) — it still shows in the blocked/handoff detail.
    cols = [("ticket", "Ticket"), ("summary", "Summary"), ("project", "Project"),
            ("phase", "Phase"), ("crew", "Crew")]
    GAP, LEAD = 2, " "
    rows = []   # list of (primary dict, jira status, phase substep)
    for it in led.get("in_flight", []):
        wt = (it.get("worktree") or "").rstrip("/")
        if live is None:
            crew = HERDR_DOWN
        elif wt in live:
            crew = live[wt][0]
        else:
            crew = NO_AGENT
        if it.get("blocked"):          # mate flagged it → needs captain feedback; overrides live status
            crew = FEEDBACK
        primary = {
            "ticket": it.get("ticket", "—"), "summary": str(it.get("summary", "")),
            "project": it.get("project", ""), "phase": phase_cell(it.get("stage", "")),
            "crew": crew,
        }
        jira = it.get("jira", "")
        jira = jira if (jira and jira != "—") else ""
        substep = str(it.get("substep", "")) if it.get("substep") else ""
        rows.append((primary, jira, substep))

    order = [k for k, _ in cols]
    left_order = [k for k in order if k != "crew"]     # crew is placed separately, far right
    CREW_GAP = 2
    TERM = term_width()
    # Data columns size to their content. Summary widens further so the longest Jira line
    # (which tucks under ticket+summary on the continuation line) fits without an ellipsis
    # — solving phase_start ≥ len(LEAD + "  ↳ " + jira) + 1 for the summary width. Then
    # clamp to [MIN, MAX] and to what the pane can show, so the board grows to fit its
    # content (no truncation) instead of either wrapping or stretching into ragged gaps.
    widths = {k: max([dwidth(h)] + [dwidth(p.get(k, "")) for p, _, _ in rows])
              for k, h in cols if k != "summary"}
    summary_content = max([dwidth("Summary")] + [dwidth(p["summary"]) for p, _, _ in rows])
    max_jira = max([0] + [dwidth(j) for _, j, _ in rows if j])
    max_substep = max([0] + [dwidth(s) for _, _, s in rows if s])
    jira_need = max_jira + 5 - widths["ticket"] - widths["project"] - 3 * GAP
    fixed = (dwidth(LEAD) + widths["ticket"] + widths["project"] + widths["phase"]
             + GAP * (len(left_order) - 1) + CREW_GAP + widths["crew"])
    # Fill: Summary stretches so the board spans the full pane width. Cap it so the crew
    # stripe (right of the phase track) and the substep (tucked under the phase on the
    # continuation line) still reach the edge without being squeezed off, and floor it at
    # what the Summary text / longest Jira line need so those never truncate.
    fill = min(SUMMARY_MAX,
               TERM - fixed,                                          # room for the crew stripe
               TERM - dwidth(LEAD) - widths["ticket"] - widths["project"]
                    - 3 * GAP - dwidth("↳ ") - max_substep)           # room for the substep
    widths["summary"] = max(SUMMARY_MIN, summary_content, jira_need, fill)
    for p, _, _ in rows:                   # truncate summaries to the resolved width
        p["summary"] = trunc(p["summary"], widths["summary"])

    def col_start(target):                 # display offset where a left-block column begins
        off = dwidth(LEAD)
        for k in left_order:
            if k == target:
                break
            off += widths[k] + GAP
        return off
    phase_start = col_start("phase")
    # Crew is a tight stripe just past the phase track (CREW_GAP is the channel), so the
    # status icons line up in a single easy-to-scan column right beside the phase.
    crew_x = col_start("phase") + widths["phase"] + CREW_GAP
    # substep tucks under the phase track; nothing sits to its right, so give it room out
    # toward the pane edge (never below its floor) and let the table rule stretch to cover
    # it — the widest line (primary or a substep continuation) sets the rule width.
    substep_w = max(SUBSTEP_MIN, TERM - phase_start - dwidth("↳ "))
    rows = [(p, jira, trunc(substep, substep_w) if substep else substep)
            for p, jira, substep in rows]
    cont_ends = [phase_start + dwidth("↳ " + s) for _, _, s in rows if s]
    total_w = max([crew_x + widths["crew"]] + cont_ends)

    def primary_line(d):
        left = LEAD + (" " * GAP).join(pad(d.get(k, ""), widths[k]) for k in left_order)
        return (pad(left, crew_x) + d.get("crew", "")).rstrip()

    def cont_line(jira, substep):
        left = LEAD + ("  ↳ " + jira if jira else "")
        if jira and dwidth(left) > phase_start - 1:      # don't let jira collide with the substep's ↳
            budget = phase_start - 1 - dwidth(LEAD + "  ↳ ")
            left = LEAD + "  ↳ " + trunc(jira, max(1, budget))
        seg = pad(left, phase_start)                     # place substep's ↳ under the phase column
        if substep:
            seg += "↳ " + substep
        return seg.rstrip()

    stamp = "static (herdr skipped/down)" if live is None else "live"
    rule = LEAD + "─" * max(0, total_w - dwidth(LEAD))
    out = [f"# Fleet — in-flight work   ·   crew = {stamp}", "",
           phase_legend(), "",
           primary_line({k: h for k, h in cols})]
    for p, jira, substep in rows:
        out.append(rule)
        out.append(primary_line(p))
        if jira or substep:
            out.append(cont_line(jira, substep))
    if rows:
        out.append(rule)                     # close the table off at the bottom
    else:
        out += [rule, "_(nothing in flight)_"]

    blocked = [it for it in led.get("in_flight", []) if it.get("blocked")]
    if blocked:
        out += ["", "## 🔴 Needs feedback — captain"]
        out += [f'- **{b.get("ticket", "—")}** ({b.get("branch","")}) — {b["blocked"]}' for b in blocked]

    done = led.get("done", [])
    if done:
        out += ["", "## Recently done"]
        out += [f'- {d.get("ticket", "—")} — {d.get("note", "")}' for d in done]
    return "\n".join(out) + "\n"


if __name__ == "__main__":
    txt = render()
    sys.stdout.write(txt)
    if "--write" in sys.argv:
        with open(SNAPSHOT, "w") as f:
            f.write(txt)
